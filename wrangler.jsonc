{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "id",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Biến môi trường công khai (Non-sensitive configuration)
  "vars": {
    "ENVIRONMENT": "production",
    "NEXT_PUBLIC_SITE_URL": "https://id.hnamhocit.workers.dev",
    "NEXT_PUBLIC_WEB_URL": "https://vntez-id.vercel.app",
    "NEXT_PUBLIC_SUPABASE_URL": "https://stbswcnsitztbusqrdhi.supabase.co",
    "ALLOWED_ORIGINS": "https://id.hnamhocit.workers.dev,https://vntez-id.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:3002"
  }

  // Khuyến nghị lưu các khóa bí mật thông qua lệnh `wrangler secret put <KEY>`:
  // - SUPABASE_SERVICE_ROLE_KEY
  // - VNTEZ_JWT_SECRET
  // - VNTEZ_JWT_PRIVATE_KEY (Tùy chọn nếu dùng RS256)
  // - VNTEZ_JWT_PUBLIC_KEY (Tùy chọn nếu dùng RS256)
}
